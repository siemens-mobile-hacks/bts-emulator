# Defaults; override any of them in .env.

# Address and UDP port where emulators reach trxmux.
TRXMUX_ADDRESS=127.0.0.1
TRXMUX_PORT=5750

# Network operator: MCC 001 and MNC 01 are the ITU test network.
# The IMSI of a home SIM card starts with MCC and MNC.
OPERATOR_MCC=001
OPERATOR_MNC=01

# Number of cells, 1 to 24. Every connected emulator gets its own cell.
BTS_CELLS=4

# GPRS authentication and GEA3 ciphering.
GPRS_CIPHERING=true

# Every new subscriber gets the key SIM_KI and the phone number MSISDN_PREFIX followed by
# the last 9 IMSI digits without leading zeros: IMSI 001010000001000 gets 1000.
SIM_KI=000102030405060708090A0B0C0D0E0F
MSISDN_PREFIX=

# Send the settings of config/provisioning.xml to every new subscriber by SMS.
PROVISION_SETTINGS=true

# GPRS gateway for emulators in a browser (gprs-gw): a WebSocket per phone,
# each with its own slirp. Address and TCP port where it is published.
GPRS_GW_ADDRESS=127.0.0.1
GPRS_GW_PORT=5751
# Page origins allowed to connect, comma separated, for example
# https://emu.example.org; empty allows any.
GPRS_GW_ORIGINS=
# Proxies in front of the gateway that append to X-Forwarded-For: 1 behind
# nginx-proxy (compose.web.yaml), 0 when clients connect directly.
GPRS_GW_TRUSTED_PROXIES=0
# Connections at once per client address (IPv6: per /64).
GPRS_GW_PER_IP=2
# Bytes per client address and day, both directions.
GPRS_GW_DAILY_BYTES=50000000
# Downlink to a phone, bytes per second and burst; more is dropped.
GPRS_GW_DOWN_RATE=10240
GPRS_GW_DOWN_BURST=81920
# An emulator's GPRS sends about 1 KB/s (one CS-1 timeslot). A client whose
# uplink averages more than this over 10 s is banned for GPRS_GW_BAN_DAYS.
GPRS_GW_BAN_RATE=20480
GPRS_GW_BAN_FRAMES=300
GPRS_GW_BAN_DAYS=182
# Seconds without traffic before a connection is closed.
GPRS_GW_IDLE=900
# Connections at once from all clients, and connection attempts per client
# address and minute.
GPRS_GW_MAX_SESSIONS=100
GPRS_GW_ATTEMPTS=20
# What a phone may reach: TCP ports on the Internet (* for any), comma
# separated. Operator proxies and MMSCs take any port; mail submission (25,
# 465, 587, 2525) and private addresses are always refused, and UDP only goes
# to DNS and WAP (9200-9203).
GPRS_GW_TCP_PORTS=80,443,8080,1080,110,143,993,995,5190,5222,5223
# New connections per phone and minute, and distinct hosts per phone and
# hour; more are dropped.
GPRS_GW_NEW_FLOWS=120
GPRS_GW_HOSTS=200
