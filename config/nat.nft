include "/run/operators/operator-proxies.nft"

define PROXY_HOSTS_ADDRESS = 192.0.2.1
define MMSC_HOSTS_ADDRESS = 192.0.2.2

# gprs-gw runs each browser phone's slirp as this user (GPRS_GW_HELPER_UID)
define GPRS_GW_UID = 64010

table ip gprs {
	set operator_proxies {
		type ipv4_addr
		elements = { $OPERATOR_PROXIES, $PROXY_HOSTS_ADDRESS }
	}

	set operator_mmscs {
		type ipv4_addr
		elements = { $OPERATOR_MMSCS, $MMSC_HOSTS_ADDRESS }
	}

	chain prerouting {
		type nat hook prerouting priority dstnat;
		iifname "apn0" meta l4proto { tcp, udp } th dport 53 redirect to :53
		iifname "apn0" ip daddr @operator_mmscs meta l4proto tcp redirect to :8002
		iifname "apn0" ip daddr @operator_proxies meta l4proto tcp redirect to :3128
		iifname "apn0" udp dport { 9200, 9201 } redirect
	}

	chain postrouting {
		type nat hook postrouting priority srcnat;
		ip saddr 172.16.32.0/24 oifname "eth0" masquerade
	}

	# A browser phone's traffic leaves through its slirp's sockets: the same
	# services as for apn0, ahead of Docker's own DNS rule
	chain output {
		type nat hook output priority dstnat - 10;
		meta skuid $GPRS_GW_UID meta l4proto { tcp, udp } th dport 53 dnat to 172.16.32.1
		meta skuid $GPRS_GW_UID ip daddr @operator_mmscs meta l4proto tcp redirect to :8002
		meta skuid $GPRS_GW_UID ip daddr @operator_proxies meta l4proto tcp redirect to :3128
		meta skuid $GPRS_GW_UID udp dport { 9200, 9201 } redirect
	}

	# and nothing else of it goes anywhere but the Internet
	chain output_filter {
		type filter hook output priority filter;
		meta skuid != $GPRS_GW_UID accept
		ct status dnat accept
		ip daddr 172.16.32.1 tcp dport 8002 accept
		tcp dport { 25, 465, 587 } reject
		ip daddr {
			0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16,
			172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15,
			198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3
		} reject
	}
}
